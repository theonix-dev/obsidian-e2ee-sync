# Obsidian E2EE Sync — container configuration.
# Copy to .env and fill in the values; .env is git-ignored.

# Required. Bearer token all clients must present (>= 16 characters).
# Generate one with:  openssl rand -hex 32
AUTH_TOKEN=

# Optional: issue one token per device instead of sharing AUTH_TOKEN.
# Losing a device then only costs removing ITS token here + a restart.
# AUTH_TOKENS=device-b-token,device-c-token

# Optional overrides.
# PORT=8080
# MAX_BODY_BYTES=268435456   # per-request (per-chunk) body cap
# MAX_FILE_BYTES=2147483648  # cap for assembled chunked uploads (2 GiB)
# TOMBSTONE_TTL_DAYS=0
# STAGING_TTL_HOURS=24       # sweep abandoned chunked uploads older than this
