# Obsidian E2EE Sync — container configuration.
# Copy to .env and fill in the values; .env is git-ignored.

# Required. Bearer token all clients must present (>= 16 characters).
# Generate one with:  openssl rand -hex 32
AUTH_TOKEN=

# Optional overrides.
# PORT=8080
# MAX_BODY_BYTES=268435456
# TOMBSTONE_TTL_DAYS=0
