{
  "name": "obsidian-e2ee-sync",
  "version": "1.0.0",
  "description": "File-by-file E2EE (AES-GCM + PBKDF2) vault sync to your own server. Desktop & mobile.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "keywords": [
    "obsidian",
    "sync",
    "e2ee",
    "encryption"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.12.12",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.21.5",
    "obsidian": "^1.4.16",
    "tslib": "^2.6.2",
    "typescript": "^5.4.5"
  }
}
